<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/morandi_background"
    tools:context=".MainActivity">

    <!-- 1. 顶部导航区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/morandi_surface"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LinkUp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/morandi_text_primary" />

        <ImageView
            android:id="@+id/icon_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginEnd="16dp"
            app:tint="@color/morandi_text_primary" />

        <ImageView
            android:id="@+id/icon_message"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/morandi_text_primary" />
    </LinearLayout>

    <!-- ScrollView for main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 2. 核心功能区（今日人脉推荐） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日人脉推荐"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/morandi_text_primary"
                android:layout_marginBottom="12dp" />

            <!-- 人脉推荐卡片 ViewPager -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager_recommendations"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp" />

            <!-- 3. 辅助功能区 -->

            <!-- 热门活动 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热门活动"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/morandi_text_primary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- 活动1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_blue">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="产品设计分享会"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/morandi_surface"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10/15 14:00"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_surface"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:text="立即报名"
                            android:textSize="10sp"
                            android:textColor="@color/morandi_blue"
                            android:background="@color/morandi_surface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 活动2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFA500">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="数据分析实战营"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/morandi_surface"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10/18 19:00"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_surface"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:text="立即报名"
                            android:textSize="10sp"
                            android:textColor="#FFA500"
                            android:background="@color/morandi_surface" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_view_all_activities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看全部"
                    android:textSize="12sp"
                    android:textColor="@color/morandi_blue"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>

            <!-- 找搭子 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="找搭子"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/morandi_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins">

                <!-- 饭搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="饭搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 学习搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="学习搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 运动搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_media_play"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="运动搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 游戏搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_dialer"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="游戏搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 旅行搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="旅行搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 聊天搭子 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/morandi_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/sym_action_chat"
                            android:layout_marginBottom="4dp"
                            app:tint="@color/morandi_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="聊天搭子"
                            android:textSize="12sp"
                            android:textColor="@color/morandi_text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 4. 底部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/morandi_surface"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/tab_match"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_match"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:layout_marginBottom="4dp"
                app:tint="@color/morandi_blue" />

            <TextView
                android:id="@+id/text_match"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="匹配"
                android:textSize="12sp"
                android:textColor="@color/morandi_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_activities"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_activities"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_month"
                android:layout_marginBottom="4dp"
                app:tint="@color/morandi_text_tertiary" />

            <TextView
                android:id="@+id/text_activities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动"
                android:textSize="12sp"
                android:textColor="@color/morandi_text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_partners"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_partners"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_input_add"
                android:layout_marginBottom="4dp"
                app:tint="@color/morandi_text_tertiary" />

            <TextView
                android:id="@+id/text_partners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搭子"
                android:textSize="12sp"
                android:textColor="@color/morandi_text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_space"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                android:layout_marginBottom="4dp"
                app:tint="@color/morandi_text_tertiary" />

            <TextView
                android:id="@+id/text_space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空间"
                android:textSize="12sp"
                android:textColor="@color/morandi_text_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:layout_marginBottom="4dp"
                app:tint="@color/morandi_text_tertiary" />

            <TextView
                android:id="@+id/text_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="12sp"
                android:textColor="@color/morandi_text_tertiary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>